{
  "name": "client",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@expo-google-fonts/vazirmatn": "^0.4.1",
    "@zekraneh/content": "workspace:*",
    "@zekraneh/domain": "workspace:*",
    "expo": "~57.0.16",
    "expo-build-properties": "~57.0.14",
    "expo-constants": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "heroui-native": "1.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.11.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "^57.0.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "workbox-build": "^7.4.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "bunx eslint .",
    "typecheck": "bunx tsc --noEmit",
    "generate:icons": "bun scripts/generate-icons.ts",
    "export:web": "bunx expo export --platform web && bun scripts/build-pwa.ts",
    "serve:pwa": "bun scripts/serve-pwa.ts",
    "build:preview:local": "export NODE_ENV=production && cd android && ./gradlew assembleRelease",
    "build:aab:local": "export NODE_ENV=production && cd android && ./gradlew bundleRelease",
    "build:preview": "bunx eas-cli@latest build --platform android --profile preview",
    "build:production": "bunx eas-cli@latest build --platform android --profile production",
    "build:production:apk": "bunx eas-cli@latest build --platform android --profile production-apk",
    "deploy:web": "bunx eas-cli@latest hosting:deploy dist"
  },
  "private": true
}
